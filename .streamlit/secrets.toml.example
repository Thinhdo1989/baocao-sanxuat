# ==============================================================================
# TỆP MẪU CẤU HÌNH BÍ MẬT STREAMLIT (SECRETS.TOML.EXAMPLE)
# Hướng dẫn: Đổi tên file này thành "secrets.toml" trong thư mục ".streamlit"
# và điền thông tin Service Account Google Cloud & Sheet IDs của bạn.
# ==============================================================================

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "your-private-key-id"
# Lưu ý private_key phải giữ nguyên định dạng gồm cả \n và nằm trong dấu ngoặc kép ""
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account-email@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account-email"
universe_domain = "googleapis.com"

# Danh sách ID các bảng tính Google Sheets (Lấy từ URL: docs.google.com/spreadsheets/d/<ID>/edit)
[sheets]
production = "1HH1r7O_eL_iW6spNruAKCM947G79rCyJRFHRVVb9apU"
kpi = "1M75tg_kZNxItv3VOlAjNi-RF63S_2NtxBMXSAxCRe14"
maint_log = "1hInwQQgN3zXWFEXC1qaFgaXeIiogXUJtm0cPgP3PlX8"
maint_plan = "1d7cmTioaJyRSGxgC7ArPUnmBtTvToby-vNCsgXV1bOQ"
process = "1ruzLoVB_LOqmwkkz4iR_1uwVyUr0A4aykl_zdXuwluw"
hr = "1enwVBuwwFK7k6r4i_xcg_7oJgckLaOfzNUkHPRZfY6s"
